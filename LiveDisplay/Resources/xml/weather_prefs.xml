<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:title="@string/weather"
  android:icon="@drawable/ic_notifications_white_24dp">

  <PreferenceCategory android:title="@string/weather"
                      app:iconSpaceReserved="false">
    
    <livedisplay.misc.IntegerListPreference
          android:selectable="true"
          android:persistent="true"
          android:defaultValue="@integer/zero_minutes"
          android:key="@string/weather_update_interval_k"
          android:title="@string/weather_update_interval_title"
          android:entries="@array/entries_weather_update_interval"
          android:entryValues="@array/values_weather_update_interval"
          app:iconSpaceReserved="false" />


  </PreferenceCategory>
</PreferenceScreen>