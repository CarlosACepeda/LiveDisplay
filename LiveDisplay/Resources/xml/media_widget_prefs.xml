<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto"
      android:title="@string/mediawidget"
      android:icon="@drawable/ic_music_widget_24dp">
  <PreferenceCategory
      android:title="@string/mediawidget"
      app:iconSpaceReserved="false">
    <SwitchPreference
      android:enabled="false"
     android:defaultValue="false"
     android:key="sync_with_zen_mode"
     android:title="@string/sync_with_zen_mode"
     android:summary="@string/sync_with_zen_mode_summary"
     app:iconSpaceReserved="false"/>
    <SwitchPreference
      android:enabled="false"
     android:defaultValue="false"
     android:key="sync_with_weather"
     android:title="@string/sync_with_weather"
     android:summary="@string/sync_with_weather_summary"
     app:iconSpaceReserved="false"/>
    <SwitchPreference
      android:enabled="false"
     android:defaultValue="false"
     android:key="show_lyrics"
     android:title="@string/show_lyrics"
     android:summary="@string/show_lyrics_summary"
     app:iconSpaceReserved="false"/>
  </PreferenceCategory>
  <PreferenceCategory
      android:title="@string/advanced"
      app:iconSpaceReserved="false">
    <SwitchPreference
      android:enabled="false"
     android:key="use_as_permanent_lock_screen"
     android:title="@string/use_as_permanent_lock_screen"
     android:summary="@string/use_as_permanent_lock_screen_summary"
     app:iconSpaceReserved="false"/>
  </PreferenceCategory>
</PreferenceScreen>