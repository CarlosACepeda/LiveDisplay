<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto"
      android:title="@string/mediawidget"
      android:icon="@drawable/ic_music_widget_24dp">
  <PreferenceCategory
      android:title="@string/mediawidget"
      app:iconSpaceReserved="false">
    <SwitchPreference
     android:defaultValue="false"
     android:key="key"
     android:title="pModeSyncWithZenOrDigitalWellbeingMode"
     app:iconSpaceReserved="false"/>
    <SwitchPreference
     android:defaultValue="false"
     android:key="key"
     android:title="pSyncWithWeatherMode"
     android:summary=""
     app:iconSpaceReserved="false"/>
    <SwitchPreference
     android:defaultValue="false"
     android:key="key"
     android:title="pShowLyrics"
     app:iconSpaceReserved="false"/>
  </PreferenceCategory>
  <PreferenceCategory
      android:title="@string/advanced"
      app:iconSpaceReserved="false">
    <SwitchPreference
     android:defaultValue="false"
     android:key="key"
     android:title="pUseAllTheTime"
     android:summary="pUse it even when Media is not playing"
     app:iconSpaceReserved="false"/>
  </PreferenceCategory>
</PreferenceScreen>