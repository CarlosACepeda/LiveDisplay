<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
   >
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/discard_media_session"
        android:paddingHorizontal="@dimen/discard_media_button_horizontal_padding"
        android:visibility="visible" 
        android:alpha="@dimen/alpha_totally_opaque"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/outline_delete_white_24"
        />
    <LinearLayout 
        android:orientation="horizontal"
        android:id="@+id/container"
        tools:visibility="visible"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_weight="@dimen/media_widget_horizontal_drag_indicator_weight"
            android:alpha="@dimen/alpha_half_visibility"
            android:src="@drawable/outline_more_vert_white_24"
            android:layout_width="@dimen/layout_width_for_weight_sum"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_weight="@dimen/media_widget_weight"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="@dimen/layout_width_for_weight_sum"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/playbackstatus"
                android:alpha="@dimen/alpha_half_visibility"
                android:text="@string/now_playing"
                android:textAlignment="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
		        android:paddingHorizontal="@dimen/media_widget_info_horizontal_padding"
                android:textAlignment="center"
		        android:textSize="@dimen/media_title_text_size"
                android:fontFamily="sans-serif-condensed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvSongName"
                android:textColor="@android:color/white"
                android:textStyle="normal" />
            <TextView
                android:singleLine="true"
                android:ellipsize="end"
                android:textAlignment="center"
                android:paddingHorizontal="@dimen/media_widget_info_horizontal_padding"
		        android:textSize="@dimen/media_artist_text_size"
                android:fontFamily="sans-serif-condensed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvArtistName"
                android:textColor="@android:color/white"
                android:textStyle="normal" />
            <TextView
                android:singleLine="true"
                android:textAlignment="center"
                android:paddingHorizontal="@dimen/media_album_text_size"
	            android:textSize="@dimen/media_album_text_size"
                android:fontFamily="sans-serif-condensed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvAlbumName"
                android:textStyle="italic"
                android:textColor="@android:color/white" />
            <SeekBar
                android:alpha="@dimen/alpha_half_visibility"
		        android:paddingHorizontal="@dimen/media_widget_info_horizontal_padding"
                android:textAlignment="center"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/seeksongTime" />
            <TextView
                android:id="@+id/sourceapp"
                android:textAlignment="center"
                android:alpha="@dimen/alpha_half_visibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <HorizontalScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:id="@+id/mediaControls">
            <androidx.appcompat.widget.AppCompatImageButton
                android:src="@drawable/ic_arrow_down_24dp"
                android:paddingHorizontal="@dimen/media_widget_controls_horizontal_padding"
                android:paddingVertical="@dimen/media_widget_controls_vertical_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/toggle_additional_controls"
                android:background="?android:attr/selectableItemBackground" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:src="@drawable/ic_skip_previous_white_24dp"
                android:paddingHorizontal="@dimen/media_widget_controls_horizontal_padding"
                android:paddingVertical="@dimen/media_widget_controls_vertical_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnMediaPrevious"
                android:background="?android:attr/selectableItemBackground" />
            <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:src="@drawable/ic_play_arrow_white_24dp"
                        android:paddingHorizontal="@dimen/media_widget_controls_horizontal_padding"
                        android:paddingVertical="@dimen/media_widget_controls_vertical_padding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/btnMediaPlayPlause"
                        android:background="?android:attr/selectableItemBackground" />
                    <ProgressBar
                        android:visibility="gone"
                        android:id="@+id/buffering"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatImageButton
                android:paddingHorizontal="@dimen/media_widget_controls_horizontal_padding"
                android:paddingVertical="@dimen/media_widget_controls_vertical_padding"
                android:src="@drawable/ic_skip_next_white_24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnMediaNext"
                android:background="?android:attr/selectableItemBackground" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:src="@drawable/outline_repeat_white_24"
                    android:paddingHorizontal="@dimen/media_widget_controls_horizontal_padding"
                    android:paddingVertical="@dimen/media_widget_controls_vertical_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/repeat"
                    android:background="?android:attr/selectableItemBackground"
                    android:visibility="visible" />
                    <!--<androidx.appcompat.widget.AppCompatImageButton
                    android:src="@drawable/outline_visibility_off_white_24"
                    android:paddingHorizontal="@dimen/media_widget_controls_horizontal_padding"
                    android:paddingVertical="@dimen/media_widget_controls_vertical_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/ignore"
                    android:background="?android:attr/selectableItemBackground"/>-->
            </LinearLayout>
           </HorizontalScrollView>
            <LinearLayout
                android:id="@+id/additional_media_controls"
                android:visibility="invisible"
                tools:visibility="visible"
                android:animateLayoutChanges="true"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageButton
                android:alpha="@dimen/alpha_half_visibility"
                tools:src="@drawable/ic_cloud_white_24dp"
                android:paddingHorizontal="@dimen/media_widget_secondary_controls_horizontal_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground" />
                <androidx.appcompat.widget.AppCompatImageButton
                android:alpha="@dimen/alpha_half_visibility"
                tools:src="@drawable/ic_awake_24dp"
                android:paddingHorizontal="@dimen/media_widget_secondary_controls_horizontal_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_gravity="center"
        android:textAlignment="center"
        android:visibility="invisible"
        android:id="@+id/no_media_playing"
        android:text="@string/nomediaplaying"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>