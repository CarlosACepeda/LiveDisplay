<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
	android:padding="@dimen/notification_widget_content_padding"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
	android:background="?android:selectableItemBackground">
	<LinearLayout
		android:gravity="center"
		android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
		<LinearLayout
			android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
			<TextView
				tools:text="Spotify"
				android:fontFamily="sans-serif-condensed"
				android:textColor="@color/primary_text_default_material_dark"
				android:textStyle="italic"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:id="@+id/app_name"/>
			<TextView
				tools:text="8:13 PM"
				android:fontFamily="sans-serif-condensed"
				android:textAppearance="?android:attr/textAppearanceSmall"
				android:textColor="@color/primary_text_default_material_dark"
				android:textStyle="italic"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:id="@+id/when" />
			<TextView
				tools:text="Trap Workout"
                android:fontFamily="sans-serif-condensed"
                android:id="@+id/subtext"
                android:maxLines="1"
				android:textAppearance="?android:attr/textAppearanceSmall"
				android:textColor="@color/primary_text_default_material_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
		</LinearLayout>
		<TextView
		tools:text="One by One - Hunter Siegel Remix"
        android:fontFamily="sans-serif-condensed"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@android:color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/title" />
		<TextView
		tools:text="GG Magree, Hunter Segel"
        android:fontFamily="sans-serif-condensed"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/primary_text_default_material_dark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/text"/>
		<ProgressBar
        android:visibility="gone"
		tools:visibility="visible"
        style="?android:attr/progressBarStyleHorizontal"
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
		<FrameLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		>
		<LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
		android:layout_height="wrap_content">
			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/action1"
				android:background="?android:attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/action2"
				android:background="?android:attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/action3"
				android:background="?android:attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/action4"
				android:background="?android:attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/action5"
				android:background="?android:attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
		</LinearLayout>
		<RelativeLayout
			android:id="@+id/inline_response_container"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:visibility="visible"
			tools:visibility="visible"
			>
			<EditText
                android:inputType="text"
                android:fontFamily="sans-serif-condensed"
				android:id="@+id/inline_response_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				/>
			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/send_inline_response"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
                android:layout_toEndOf="@id/inline_response_text"
                android:background="?android:selectableItemBackground"
                android:src="@drawable/baseline_send_white_24"
			/>
			</RelativeLayout>
		</FrameLayout>
	</LinearLayout>
	<LinearLayout
		android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
		<androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/toggle_collapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
		<androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/close"
				android:src="@drawable/baseline_close_white_18"
                android:layout_width="wrap_content"
			android:background="?android:attr/selectableItemBackground"
                android:layout_height="wrap_content"/>
	</LinearLayout>
</LinearLayout>