<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
	android:padding="@dimen/notification_widget_content_padding"
    android:layout_width="@dimen/notification_card_width"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/notification_card_corner_radius"
    app:cardElevation="@dimen/notification_card_elevation"

    tools:visibility="visible"
    android:clickable="true" 
    android:focusableInTouchMode="true"
	android:background="?android:selectableItemBackground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/app_name"
                android:padding="@dimen/notification_app_name_padding"
                android:gravity="center"
                android:textSize="@dimen/notification_app_name_text_size"
                tools:text="WhatsApp"
                android:fontFamily="sans-serif-condensed"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <Button
                android:id="@+id/next_app_button"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                tools:text="Telegram"
                android:fontFamily="sans-serif-condensed"
                android:alpha="@dimen/alpha_half_visibility"
                android:textAllCaps="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <TextView
            android:id="@+id/title"
            tools:text="Message from Anechka"
            android:padding="@dimen/notification_title_padding"
            android:fontFamily="sans-serif-condensed"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_width="match_parent"/>
        <TextView
            android:id="@+id/text"
            android:padding="@dimen/notification_text_padding"
            tools:text="The dog is really cute! Show me more pictures of it! Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis commodo urna ac ultrices tincidunt. Quisque fringilla lobortis lacus vehicula congue. Pellentesque dictum rutrum ultricies. Nam mi odio, imperdiet sit amet velit at, feugiat ultrices arcu. Curabitur sodales augue eget venenatis suscipit. Pellentesque fringilla lectus sit amet felis commodo elementum. Suspendisse maximus, turpis blandit condimentum tempus, lectus leo commodo ex, nec fermentum metus libero id dolor."
            android:maxLines="@integer/notification_text_max_lines"
            android:fontFamily="sans-serif-condensed"
            android:ellipsize="end"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="horizontal"
            android:weightSum="@integer/notification_response_linear_layout_weight_sum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:layout_weight="@integer/notification_response_text_weight"
            android:id="@+id/response"
            android:inputType="text"
            android:imeOptions="actionSend"
            tools:hint="Response"
            android:textSize="@dimen/notification_response_text_size"
            android:fontFamily="sans-serif-condensed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/send_response"
                android:layout_weight="@integer/notification_response_button_weight"
                android:src="@drawable/baseline_send_white_24"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        
        <TextView
            android:paddingHorizontal="@dimen/notification_other_actions_text_horizontal_padding"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/notification_more_actions"
            android:textSize="@dimen/notification_other_actions_text_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:paddingHorizontal="@dimen/notification_action_buttons_container_horizontal_padding"
            android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <Button
                android:id="@+id/action_one"
                tools:text="Mark as read"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <Button
                android:id="@+id/action_two"
                tools:text="Snooze"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <Button
                android:id="@+id/action_three"
                tools:text="delete"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/previous_message"
                android:src="@drawable/outline_keyboard_arrow_up_white_18"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/next_message"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/outline_keyboard_arrow_down_white_18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>