
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="wrap_content"
    a:layout_height="wrap_content"
	a:id="@+id/container"
	a:orientation="horizontal"
    a:gravity="center">
    <androidx.appcompat.widget.AppCompatImageButton
        a:background="?android:attr/selectableItemBackgroundBorderless"
        a:id="@+id/weather_indicator"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"/>
    <TextView
        a:id="@+id/weather_current_degrees"
        a:textSize="@dimen/current_weather_text_size"
        a:alpha="@dimen/alpha_half_visibility"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"/>
	<TextView
		tools:text="3/11 "
        a:layout_width="wrap_content"
		a:textSize="@dimen/date_text_size"
        a:alpha="@dimen/alpha_half_visibility"
        a:layout_height="wrap_content"
		a:fontFamily="sans-serif-condensed-light"
        a:paddingHorizontal="@dimen/mini_widget_items_padding"
        a:id="@+id/date" />
    <TextClock
        a:id="@+id/clock"
        tools:text="8:45 p.m."
        a:background="?android:selectableItemBackground"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:textSize="@dimen/clock_text_size"
        a:fontFamily="sans-serif-condensed-light"
        a:paddingHorizontal="@dimen/mini_widget_items_padding"
        />
	<androidx.appcompat.widget.AppCompatImageView
        a:id="@+id/batteryIcon"
        a:alpha="@dimen/alpha_half_visibility"
        a:paddingHorizontal="@dimen/mini_widget_items_padding"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content" />
    <TextView
		tools:text="75%"
        a:id="@+id/batteryLevel"
		a:fontFamily="sans-serif-condensed-light"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content" 
        a:alpha="@dimen/alpha_half_visibility"
        a:paddingHorizontal="@dimen/mini_widget_items_padding"
		a:textSize="@dimen/battery_level_text_size"/>
    <FrameLayout
        a:alpha="@dimen/alpha_half_visibility"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageButton
            a:background="?android:attr/selectableItemBackgroundBorderless"
            a:id="@+id/message_indicator"
            a:src="@drawable/baseline_chat_white_18"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"/>
        <TextView
            a:id="@+id/messages_counter"
            a:background="@android:color/black"
            a:textSize="@dimen/current_messages_counter_text_size"
            a:layout_gravity="end"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>